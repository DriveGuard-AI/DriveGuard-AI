<?xml version="1.0" encoding="UTF-8"?><mxfile host="drawio"><diagram name="部署优先关系门控-设计基线"><mxGraphModel grid="1" gridSize="10" pageWidth="1380" pageHeight="1390"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="单摄像头 / 同一帧&#xa;采集时间戳 · 不拼接多视角" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="450" y="20" width="380" height="70" as="geometry"/></mxCell><mxCell id="3" value="YOLOX Nano · 冻结&#xa;手机 / 瓶 / 杯检测" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="70" y="150" width="330" height="85" as="geometry"/></mxCell><mxCell id="4" value="MediaPipe Hand · 冻结&#xa;手部关键点 / 归属约束" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="330" height="85" as="geometry"/></mxCell><mxCell id="5" value="MediaPipe Face · 冻结&#xa;眼 / 嘴 / 面部关键点" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="870" y="150" width="330" height="85" as="geometry"/></mxCell><mxCell id="6" value="统一时空与有效性（扩展依赖掩码）&#xa;缺失、过期、归属不明 → 无效；不伪造正常值" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="280" y="315" width="700" height="85" as="geometry"/></mxCell><mxCell id="7" value="F：面部状态流&#xa;EAR / MAR / 闭眼与眨眼" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="485" width="270" height="85" as="geometry"/></mxCell><mxCell id="8" value="O：物体证据流&#xa;类别 / 检测分数 / 有效零检测" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="350" y="485" width="270" height="85" as="geometry"/></mxCell><mxCell id="9" value="HO：手—物关系流&#xa;距离 / IoU / 邻近持续时间" styl